# Server-only -- deliberately NOT prefixed NEXT_PUBLIC_. In this
# version, the browser never calls the Express API directly (every
# call is server-to-server: Route Handlers, Middleware, Server
# Components), so this value never needs to reach the client bundle.
# That's a real difference from the client-side version, not
# incidental -- there, NEXT_PUBLIC_API_URL is unavoidable since the
# browser itself has to know where to fetch.
API_URL=https://university-portal-production-db8b.up.railway.app

# Must match the API's own JWT_ACCESS_SECRET exactly (see the API
# repo's .env) -- this app uses it to cryptographically verify access
# tokens (Proxy, and app/page.js's root redirect) via `jose`, rather
# than trusting an unverified payload decode. A real coupling between
# the two apps: if the API rotates this secret, it must be updated
# here too.
JWT_ACCESS_SECRET=change-this-to-a-long-random-string

# --- Cloudinary (profile photo hosting) ---
# Server-only, all three, and none prefixed NEXT_PUBLIC_ even though
# two of them are not secrets. The browser does upload directly to
# Cloudinary, but it learns the cloud name and API key from the
# response to app/api/users/me/avatar/signature rather than from the
# bundle -- so nothing Cloudinary-related is baked in at build time,
# the same posture as API_URL above.
#
# Only the secret is a real credential: it signs the upload and never
# leaves the server. A signature it produces is scoped to one
# public_id, chosen server-side from the verified session, so it can't
# be replayed against anyone else's avatar.
#
# From the Cloudinary dashboard (Programmable Media -> API Keys).
# Without these the profile photo button answers 503 and everything
# else on /account/profile still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# This deployment's institution folder in the Cloudinary media
# library: "development" while building, a school's own folder in
# production. It must already exist in the account.
#
# One value per deployment, not per request, because that's how the
# app is tenanted everywhere else -- one institution runs one copy,
# same as APP_NAME in lib/branding.js.
#
# It is also part of every uploaded photo's public_id
# (<folder>/avatars/user_<id>), so two institutions' user 12 can never
# collide, and a signature minted for one can't be replayed against
# the other.
CLOUDINARY_FOLDER=development
